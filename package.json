    "@sanity/client": "^8.5.0",
    "canvas-confetti": "^1.9.4",
    "isbot": "^5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-router": "^7.18.3",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^7.18.3",
    "@types/canvas-confetti": "^1.9.0",
